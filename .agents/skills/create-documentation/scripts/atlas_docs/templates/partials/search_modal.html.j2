<div class="search-modal" id="search-modal" aria-hidden="true">
  <div class="search-panel">
    <div class="search-toolbar">
      <input id="search-input" class="search-input" type="search" placeholder="Search local docs..." autocomplete="off">
      <button class="search-close" type="button" data-close-search>Esc</button>
    </div>
    <div id="search-status" class="search-status">Search is ready</div>
    <div id="search-results" class="search-results">
      <div class="search-empty">
        <strong>Search the local docs. Try docs, guides, examples.</strong>
      </div>
    </div>
  </div>
</div>
