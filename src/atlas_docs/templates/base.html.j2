<!DOCTYPE html>
<html lang="en" data-color-scheme="{{ theme.color_scheme | default('dark') }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if theme.font_source %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.font_source | safe }}" rel="stylesheet">
{% endif %}
<title>{{ site.metadata.name }} &mdash; Docs</title>
<script>
  (function () {
    var defaultScheme = "{{ theme.color_scheme | default('dark') }}";
    var resolvedScheme = defaultScheme === "light" ? "light" : "dark";

    try {
      var storage = window.localStorage;
      var raw = storage && storage.getItem("atlas-docs-settings");
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed && parsed.colorScheme === "light") {
          resolvedScheme = "light";
        } else if (parsed && parsed.colorScheme === "dark") {
          resolvedScheme = "dark";
        }
      }
    } catch (_error) {
      // Ignore storage failures and keep the theme default for first paint.
    }

    document.documentElement.dataset.colorScheme = resolvedScheme;
    document.documentElement.style.colorScheme = resolvedScheme;
  })();
</script>
<style>
  {{ css | safe }}
</style>
</head>
<body>
<script>
  window.__ATLAS_DOCS__ = {{ atlas_config_json | safe }};
</script>

<div class="shell">

  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <div class="logo-name">
        {{ site.metadata.name }}
        {% if site.metadata.version %}<span class="logo-pill">{{ site.metadata.version }}</span>{% endif %}
      </div>
      {% if site.metadata.tagline %}<div class="logo-tagline">{{ site.metadata.tagline }}</div>{% endif %}
    </div>

    <nav>{% for group in site.nav_groups %}
      <div class="nav-group">
        <div class="nav-group-label">{{ group.label }}</div>{% for entry in group.entries %}{% if entry.external %}
        <a class="nav-link" href="{{ entry.target }}" target="_blank" rel="noopener noreferrer">
          <span class="dot"></span> {{ entry.label }}
        </a>{% else %}
        <a class="nav-link{% if entry.slug == site.default_section %} active{% endif %}" href="#section-{{ entry.slug }}" data-section-link="{{ entry.slug }}">
          <span class="dot"></span> {{ entry.label }}
        </a>{% endif %}{% endfor %}
      </div>{{ "\n" if not loop.last else "" }}{% endfor %}
    </nav>
{% if site.footer %}
    <div class="sidebar-footer">
      <div class="nav-group-label">{{ site.footer.label }}</div>{% for entry in site.footer.entries %}{% if entry.external %}
      <a class="nav-link nav-link-external" href="{{ entry.target }}" target="_blank" rel="noopener noreferrer">
        <span class="dot"></span> {{ entry.label }}
      </a>{% else %}
      <a class="nav-link{% if entry.slug == site.default_section %} active{% endif %}" href="#section-{{ entry.slug }}" data-section-link="{{ entry.slug }}">
        <span class="dot"></span> {{ entry.label }}
      </a>{% endif %}{% endfor %}
    </div>
{% endif %}
  </aside>

  <button
    class="sidebar-scrim"
    type="button"
    data-sidebar-scrim
    aria-label="Close navigation menu"
    tabindex="-1"
  ></button>

  <div class="main">
    <div class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle" type="button" data-toggle-sidebar>&#9776;</button>
        <div class="breadcrumb" id="breadcrumb">
          {% if site.sections %}{{ site.sections[0].breadcrumb.split('/')[0].strip() }} <span>/</span> {{ site.sections[0].breadcrumb.split('/')[-1].strip() }}{% else %}{{ site.metadata.name | lower }} <span>/</span> docs{% endif %}
        </div>
      </div>
      <div class="topbar-actions">
{% if site.metadata.get("features", {}).get("search", true) %}
        <button class="search-trigger" type="button" data-open-search>
          <span aria-hidden="true">Search</span>
          <span class="search-trigger-label">{{ site.metadata.get("search_trigger_label", "docs, guides, examples...") }}</span>
          <span class="search-trigger-kbd">Ctrl K</span>
        </button>
{% endif %}
        <button class="topbar-icon-button" type="button" data-open-settings aria-label="Open settings" aria-haspopup="dialog" aria-controls="settings-modal">
          <span aria-hidden="true">&#9881;</span>
        </button>
      </div>
    </div>

    <div class="content-outer">
{% for section in site.sections %}{% if section.comment_label %}
      <!-- ====================================== {{ section.comment_label }} -->
{% endif %}      <div class="section{% if section.slug == site.default_section %} active{% endif %}" id="section-{{ section.slug }}" data-section="{{ section.slug }}">
        <div class="page-hero">
{% if section.tag %}          <div class="page-tag">{{ section.tag }}</div>
{% endif %}          <h1 class="page-title">{{ section.title }}{% if section.title_em %}{% if section.title_em[:1] not in [".", ",", ":", ";", "!", "?"] %} {% endif %}<em>{{ section.title_em }}</em>{% endif %}</h1>
{% if section.lead_html %}          <p class="page-lead">{{ section.lead_html | safe }}</p>
{% endif %}        </div>

{{ section.body_html | indent_section_html(8) | safe }}
      </div>{{ "\n" if loop.last else ("\n" if site.sections[loop.index].comment_label else "\n\n") }}{% endfor %}
    </div>
  </div>
</div>

<div class="search-modal" id="search-modal" aria-hidden="true">
  <div class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-input-label">
    <div class="search-head">
      <div class="search-input-wrap">
        <span aria-hidden="true">&#8981;</span>
        <label id="search-input-label" class="search-trigger-label" for="search-input" style="display:none;">Search docs</label>
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder="{{ site.metadata.get('search_placeholder', 'Search local docs...') }}"
          autocomplete="off"
          spellcheck="false"
        >
      </div>
      <button class="search-close" type="button" data-close-search>Esc</button>
    </div>
    <div class="search-toolbar">
      <div id="search-status">Search is ready</div>
    </div>
    <div class="search-results" id="search-results">
      <div class="search-empty">
        <strong>{{ site.metadata.get("search_secondary_hint", "Search the local docs. Try docs, guides, examples.") }}</strong>
      </div>
    </div>
  </div>
</div>
<div class="settings-modal" id="settings-modal" aria-hidden="true">
  <div class="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settings-title">
    <div class="settings-head">
      <div>
        <div class="settings-kicker">Config</div>
        <h2 class="settings-title" id="settings-title">Interface settings</h2>
      </div>
      <button class="search-close" type="button" data-close-settings>Esc</button>
    </div>
    <div class="settings-body">
      <label class="settings-option" for="setting-readable-line-length">
        <div class="settings-option-copy">
          <strong>Readable line length</strong>
          <span>Center the document column and limit long lines for a more readable layout.</span>
        </div>
        <span class="settings-switch">
          <input id="setting-readable-line-length" type="checkbox" data-setting="readableLineLength">
          <span class="settings-switch-ui" aria-hidden="true"></span>
        </span>
      </label>
      <label class="settings-option settings-option-range" for="setting-line-width">
        <div class="settings-option-copy">
          <strong>Line width</strong>
          <span>Adjust the maximum width of the reading column.</span>
        </div>
        <div class="settings-range-wrap">
          <input
            id="setting-line-width"
            class="settings-range"
            type="range"
            min="640"
            max="1300"
            step="20"
            value="860"
            data-setting="lineWidth"
          >
          <output class="settings-range-value" id="setting-line-width-value" for="setting-line-width">860px</output>
        </div>
      </label>
      <label class="settings-option" for="setting-prefers-motion">
        <div class="settings-option-copy">
          <strong>Prefers motion</strong>
          <span>Allow transitions and motion flourishes across the docs UI.</span>
        </div>
        <span class="settings-switch">
          <input id="setting-prefers-motion" type="checkbox" data-setting="prefersMotion">
          <span class="settings-switch-ui" aria-hidden="true"></span>
        </span>
      </label>
      {% if atlas_config.theme.supportsToggle %}
      <label class="settings-option" for="setting-color-scheme">
        <div class="settings-option-copy">
          <strong>Light mode</strong>
          <span>Swap the docs palette between the default dark presentation and the new light variant.</span>
        </div>
        <span class="settings-switch">
          <input id="setting-color-scheme" type="checkbox" data-setting="colorScheme" value="light">
          <span class="settings-switch-ui" aria-hidden="true"></span>
        </span>
      </label>
      {% endif %}
    </div>
  </div>
</div>
<script>
  {{ js | safe }}
</script>

</body>
</html>
